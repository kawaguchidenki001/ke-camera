/* ============================================================ 入り口 */

function step1_preview() { run_(true); }    // 下見(変更しない)
function step2_rename()  { run_(false); }   // 実行(名前を変える)

function resetProgress() {
  PropertiesService.getScriptProperties().deleteProperty('rename_dry');
  PropertiesService.getScriptProperties().deleteProperty('rename_run');
  Logger.log('進捗をリセットしました。次回は最初から実行します。');
}

/* ============================================================ 本体 */

function run_(dry) {
  var key   = dry ? 'rename_dry' : 'rename_run';
  var props = PropertiesService.getScriptProperties();
  var st = JSON.parse(props.getProperty(key) || 'null') || {
    pi: 0, token: null,
    n_scan: 0, n_hit: 0, n_skip_done: 0, n_amb: 0, n_other: 0, n_bad: 0,
    samples: [], ambFiles: []
  };
  var start = Date.now();
  var timedOut = false;

  for (var i = st.pi; i < TARGET_PARENT_IDS.length && !timedOut; i++) {
    var parent;
    try {
      parent = DriveApp.getFolderById(TARGET_PARENT_IDS[i]);
    } catch (e) {
      Logger.log('フォルダを開けません(スキップ): ' + TARGET_PARENT_IDS[i]);
      st.pi = i + 1; st.token = null;
      continue;
    }
    var it = st.token ? DriveApp.continueFolderIterator(st.token) : parent.getFolders();

    while (it.hasNext()) {
      if (Date.now() - start > MAX_RUN_MS) { timedOut = true; break; }
      var roomFolder = it.next();
      var roomName = roomFolder.getName();
      if (roomName.charAt(0) !== '_') {          // _uploading_tmp などは対象外
        processRoom_(roomFolder, roomName, dry, st);
      }
      st.token = it.getContinuationToken();
    }
    if (!timedOut) { st.pi = i + 1; st.token = null; }
  }

  if (timedOut) {
    props.setProperty(key, JSON.stringify(st));
    report_(st, dry, false);
  } else {
    props.deleteProperty(key);
    report_(st, dry, true);
  }
}

function processRoom_(folder, roomName, dry, st) {
  var files = folder.getFiles();
  while (files.hasNext()) {
    var file = files.next();
    var name = file.getName();
    st.n_scan++;

    var parsed = parseName_(name);
    if (!parsed) { st.n_bad++; continue; }

    // 部屋の特定はファイル名を優先し、表に無ければフォルダ名で引く
    var roomKey = (RENAME_MAP[parsed.room] || AMBIGUOUS[parsed.room]) ? parsed.room : roomName;
    var fixture = parsed.fixture;

    // 判断できない部屋の記号は触らない
    var amb = AMBIGUOUS[roomKey];
    if (amb && amb.indexOf(fixture) >= 0) {
      st.n_amb++;
      if (st.ambFiles.length < LOG_SAMPLE) st.ambFiles.push(roomKey + ' / ' + name);
      continue;
    }

    var map = RENAME_MAP[roomKey];
    if (!map || !map[fixture]) { st.n_other++; continue; }   // 変換不要な記号

    var newName = parsed.head + map[fixture] + parsed.tail;
    if (newName === name) { st.n_skip_done++; continue; }

    st.n_hit++;
    if (st.samples.length < LOG_SAMPLE) st.samples.push(name + '  →  ' + newName);
    if (!dry) file.setName(newName);
  }
}

/**
 * ファイル名を {前半}{器具記号}{後半} に分解する。
 * 形式: 日付_棟-部屋_記号_施工段階_連番[.jpg] / 末尾に _nb が付くことがある
 */
function parseName_(name) {
  var m = name.match(/^(.+)\.(jpe?g)$/i);
  if (!m) return null;
  var stem = m[1], ext = m[2];
  var parts = stem.split('_');
  if (parts.length !== 5 && parts.length !== 6) return null;      // 想定外の形式は触らない
  if (parts.length === 6 && parts[5] !== 'nb') return null;
  var room = parts[1];
  var fixture = parts[2];
  var head = parts[0] + '_' + parts[1] + '_';
  var tail = '_' + parts.slice(3).join('_') + '.' + ext;
  return { room: room, fixture: fixture, head: head, tail: tail };
}

function report_(st, dry, finished) {
  var mode = dry ? '【下見】ファイルは変更していません' : '【実行】ファイル名を変更しました';
  var lines = [];
  lines.push('==============================================');
  lines.push(mode);
  lines.push(finished ? '状態: 完了' : '状態: 時間切れで中断 → 同じ関数をもう一度実行すると続きから再開します');
  lines.push('----------------------------------------------');
  lines.push('調べたファイル      : ' + st.n_scan);
  lines.push((dry ? '変更される予定    : ' : '変更したファイル  : ') + st.n_hit);
  lines.push('変更不要(対象外記号): ' + st.n_other);
  lines.push('すでに枝番付き      : ' + st.n_skip_done);
  lines.push('判断できず据え置き  : ' + st.n_amb + '  ← 同じ部屋に -1 と -2 が両方ある場合');
  lines.push('形式が違い対象外    : ' + st.n_bad);
  lines.push('==============================================');
  if (st.samples.length) {
    lines.push('');
    lines.push('■ 変更' + (dry ? '予定' : '内容') + '(先頭' + st.samples.length + '件)');
    for (var i = 0; i < st.samples.length; i++) lines.push('  ' + st.samples[i]);
  }
  if (st.ambFiles.length) {
    lines.push('');
    lines.push('■ 判断できなかったファイル(先頭' + st.ambFiles.length + '件) — 手で直すかご判断ください');
    for (var j = 0; j < st.ambFiles.length; j++) lines.push('  ' + st.ambFiles[j]);
  }
  Logger.log(lines.join('\n'));
}
